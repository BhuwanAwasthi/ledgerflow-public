# --- Azure OpenAI (the only paid service) ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# --- Local dev defaults ---
DATABASE_URL=sqlite:///./ledgerflow.db
STORAGE_BACKEND=local            # local | supabase
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- Sign-in ---
# dev = stub login for local and e2e runs (refuses to start with Postgres, Supabase storage or on Render)
# supabase = Supabase Auth (Google); tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json
AUTH_MODE=dev
SUPABASE_JWT_SECRET=           # only for a Supabase project still on the legacy HS256 secret
FILE_TOKEN_SECRET=             # HMAC key of the 60 s file links; random per process when empty

# --- Production (Render env vars; leave empty locally) ---
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# --- Frontend (frontend/.env locally, where Vite reads them; Vercel env vars in prod) ---
VITE_API_URL=http://localhost:8000
# Supabase > Project Settings > API: the project URL https://<ref>.supabase.co (not the pooler host) and the anon key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = include the AUTH_MODE=dev stub login in a `vite build` (e2e only); never set it on Vercel
VITE_DEV_LOGIN=
